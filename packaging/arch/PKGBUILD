# Maintainer: nuclearcanopy
pkgname=hmecli
pkgver=0.1.0
pkgrel=1
pkgdesc='Generate iCloud Hide My Email aliases from the command line'
arch=('any')
url='https://github.com/nuclearcanopy/hmecli'
license=('MIT')
depends=('python' 'python-browser-cookie3')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Builds from the checkout containing this directory.
_src="$startdir/../.."

prepare() {
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  cp -r "$_src"/{hmecli.py,test_hmecli.py,pyproject.toml,README.md,LICENSE} "$srcdir/$pkgname/"
}

build() {
  cd "$srcdir/$pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname"
  python -m unittest test_hmecli
}

package() {
  cd "$srcdir/$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
